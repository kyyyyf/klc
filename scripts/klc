#!/usr/bin/env python3
"""klc — unified dispatcher for the Codebase Intelligence Framework.

The ticket lifecycle is driven by a handful of verbs:

    intake       — create a ticket (puts it in `intake:ack-needed`)
    status       — show the current path through the ticket's track and the next action
    go           — move a ticket one step forward from any state (`--pick N`,
                   `--dry-run`, `--until <phase>`)
    back         — return a ticket to an earlier phase with a reason (`--cancel` cancels)
    step verify  — run a build step's VERIFY once and record the result
    fix          — correct a ticket's track, modules, risk-tags, kind, epic or
                   blocked-by with a reason; every change is audited in meta.fixes

Also: board, doctor, jira, publish

Each subcommand has its own --help.
"""
from __future__ import annotations

import importlib.util
import os
import sys
from pathlib import Path


SCRIPT = Path(__file__).resolve()
FRAMEWORK_ROOT = SCRIPT.parent.parent
SKILLS_DIR = FRAMEWORK_ROOT / "core" / "skills"
PHASES_DIR = FRAMEWORK_ROOT / "core" / "phases"

sys.path.insert(0, str(SKILLS_DIR))


def _load_module(path: Path, name: str):
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise ImportError(f"cannot import {path}")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _run_phase(name: str, argv: list[str]) -> int:
    path = PHASES_DIR / f"{name.replace('-', '_')}.py"
    if not path.exists():
        sys.stderr.write(f"klc: command not implemented: {name}\n")
        return 2
    mod = _load_module(path, f"klc_phase_{name.replace('-', '_')}")
    if not hasattr(mod, "run"):
        sys.stderr.write(f"klc: {path} has no run() entry point\n")
        return 2
    return int(mod.run(argv))


def _run_skill_subcommand(skill: str, subcommand: str, argv: list[str]) -> int:
    path = SKILLS_DIR / f"{skill}.py"
    if not path.exists():
        sys.stderr.write(f"klc: skill not found: {skill}\n")
        return 2
    import subprocess
    return subprocess.call(
        [sys.executable, str(path), subcommand, *argv],
        env={**os.environ, "PROJECT_ROOT": _project_root()},
    )


def _project_root() -> str:
    env = os.environ.get("PROJECT_ROOT")
    if env:
        return str(Path(env).resolve())
    return str(FRAMEWORK_ROOT.parent)


# --- subcommand dispatch ------------------------------------------------------

LIFECYCLE_CMDS = ("intake", "status", "go", "back", "step", "fix")
# Only verbs that have a real core/phases/<name>.py belong here — the dispatch
# below routes these through the generic `_run_phase`. `jira-sync`, `metrics`,
# `reindex` have no phase file of that name, so they are served by explicit
# handlers (KLC-072); listing them here would shadow those handlers.
OPERATIONAL_CMDS = (
    "board", "doctor", "jira", "publish",
)

# Bootstrap verbs folded into `klc doctor` (KLC-178). They stay hidden aliases:
# the dispatcher prints ONE stderr pointer, then does the old work unchanged.
# `state` has `init` as its only subcommand, so the whole verb is an alias.
# Value = the replacement command line shown in the pointer.
_DEPRECATED_BOOTSTRAP = {
    "install": "klc doctor --install <root>",
    "init": "klc doctor --index (agent doc passes: klc internal init --auto, klc internal init --finalize)",
    "update": "klc doctor --index (doc regeneration: klc internal update --regen)",
    "setup": "klc doctor",
    "state": "klc doctor --install <root>",
}
_BOOTSTRAP_PHASES = ("install", "setup", "state")

# Old forward/backward verbs (KLC-177). They stay callable for one release and
# print ONE deprecation line from the dispatcher (never from a phase module's
# run(): `go` calls next/ack in-process with captured output). `run` keeps its
# old headless-dispatch behaviour; it is not an alias of `go --until`.
# The value is the replacement command line, shown as-is in the one deprecation line.
DEPRECATED = {
    "next": "go <KEY>", "ack": "go <KEY> [--pick N]", "ship": "go <KEY> [--pick N]",
    "run": "go <KEY> --until <phase>",
    "jump": "back <KEY> <phase> --reason TEXT",
    "abort": "back <KEY> <phase> --reason TEXT (or back <KEY> --cancel --reason TEXT)",
    "retrack": "fix <KEY> track <TRACK> --reason TEXT",
    "scope-fix": "fix <KEY> modules --add|--remove|--set <m1,m2> --reason TEXT",
}
_DEPRECATED_PHASES = tuple(DEPRECATED)

# Maintainer and hook verbs, reachable as `klc internal <name>` and left out of
# the public help. They are also still served under their old top-level spelling
# without a deprecation line, because existing scripts call them. KLC-178 removes
# the top-level spellings. (`remind` and `heartbeat` are gone: the single plugin
# hook calls `core/skills/klc_hook.py` in-process, KLC-180.)
INTERNAL_CMDS = (
    "task-brief", "build-run", "jira-sync", "reindex", "metrics", "migrate-notes",
    "skeleton", "plugin-gen", "steal", "step-card", "run",
    "init", "update",
)
_INTERNAL_PHASES = ("task-brief", "build-run", "migrate-notes", "steal")

# Commands that must NOT trigger the opportunistic Jira-queue drain:
#   jira-sync — drains explicitly itself.
#   publish   — a read-only forge-publish verb (KLC-003); it makes no lifecycle
#               writes, so a drain would be an unadvertised write side effect.
#   skeleton  — a read-only outline of one file (KLC-139); makes no writes.
#   status    — a read-only phase/state query (KLC-153); it must not spend the
#               Jira transport timeout.
NO_DRAIN_CMDS = ("jira-sync", "publish", "skeleton", "status")


def _drain_jira_queue() -> None:
    """Opportunistic drain — called on every klc command, no-op if queue empty."""
    try:
        sys.path.insert(0, str(SKILLS_DIR))
        import jira_sync as _js
        if _js.queue_size() > 0:
            _js.flush_queue(timeout=2.0, quiet=True)
    except Exception:
        pass


def _dispatch(argv: list[str], *, internal: bool = False) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        _print_help()
        return 0
    cmd, rest = argv[0], argv[1:]

    if cmd == "internal":
        if not rest or rest[0] not in INTERNAL_CMDS:
            sys.stderr.write("usage: klc internal <name> [args]\n"
                             f"  names: {', '.join(INTERNAL_CMDS)}\n")
            return 2
        return _dispatch(rest, internal=True)

    if cmd in DEPRECATED and not internal:
        sys.stderr.write(f"klc {cmd} is deprecated: use klc {DEPRECATED[cmd]} "
                         f"(removed after wave 3)\n")

    if cmd in _DEPRECATED_BOOTSTRAP and not internal:
        name = "state init" if cmd == "state" else cmd
        sys.stderr.write(f"klc {name} is deprecated: use {_DEPRECATED_BOOTSTRAP[cmd]}\n")

    # drain Jira queue opportunistically, except for advisory/self-draining verbs
    # `go --dry-run` only reads, so it skips the drain like `status`.
    if cmd not in NO_DRAIN_CMDS and not (cmd == "go" and "--dry-run" in rest):
        _drain_jira_queue()

    if cmd in ("--version", "-V"):
        print("klc 0.2")
        return 0

    if cmd in LIFECYCLE_CMDS or cmd in OPERATIONAL_CMDS or cmd in _DEPRECATED_PHASES \
            or cmd in _BOOTSTRAP_PHASES \
            or cmd in _INTERNAL_PHASES:
        return _run_phase(cmd, rest)

    if cmd == "step-card":
        return _run_phase("step", rest)

    # jira-sync's wrapper module is core/phases/jira_sync_cmd.py, so it cannot be
    # routed by name via OPERATIONAL_CMDS (that would look for jira_sync.py).
    if cmd == "jira-sync":
        return _run_phase("jira_sync_cmd", rest)

    if cmd == "reindex":
        if not rest:
            sys.stderr.write("usage: klc reindex <ticket>\n"); return 2
        return _run_skill_subcommand("items", "index", ["--ticket", rest[0]])

    if cmd == "metrics":
        if rest and rest[0] == "--rollup":
            return _run_skill_subcommand("metrics", "rollup", rest[1:])
        if not rest:
            sys.stderr.write("usage: klc metrics <ticket> | klc metrics --rollup\n"); return 2
        return _run_skill_subcommand("metrics", "show", ["--ticket", rest[0]])

    if cmd == "plugin-gen":
        sys.path.insert(0, str(SKILLS_DIR))
        import plugin_gen as _pg
        return _pg.main(rest)

    if cmd == "skeleton":
        sys.path.insert(0, str(SKILLS_DIR))
        import skeleton as _sk
        return _sk.main(rest)

    if cmd in ("init", "update"):
        script = FRAMEWORK_ROOT / "scripts" / f"{cmd}.py"
        if not script.exists():
            sys.stderr.write(f"klc: {script} missing\n"); return 2
        import subprocess
        return subprocess.call(
            [sys.executable, str(script), *rest],
            env={**os.environ, "PROJECT_ROOT": _project_root()},
        )

    # NB: `jira` is served by core/phases/jira.py via OPERATIONAL_CMDS above —
    # it never reaches here, so no explicit `jira` handler is needed (KLC-072).

    sys.stderr.write(f"klc: unknown subcommand: {cmd}\n")
    _print_help()
    return 2


def _print_help() -> None:
    print(__doc__.strip())


if __name__ == "__main__":
    sys.exit(_dispatch(sys.argv[1:]))
